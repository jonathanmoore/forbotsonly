# Prodigi API Configuration
# Get your API keys from https://dashboard.prodigi.com
# Navigate to Settings → Integrations → API

# SANDBOX (default) - For testing and rehearsal
# Host: api.sandbox.prodigi.com
PRODIGI_API_KEY=your_sandbox_api_key_here
# PRODIGI_BASE_URL=https://api.sandbox.prodigi.com

# LIVE - For production orders (real money, real fulfillment)
# Host: api.prodigi.com
# CRITICAL: Live key must NEVER be committed to git. Use secrets manager in production.
# PRODIGI_API_KEY=your_live_api_key_here
# PRODIGI_BASE_URL=https://api.prodigi.com

# Product SKU (defaults to GLOBAL-TEE-BC-3001 if not set)
PRODIGI_SKU=GLOBAL-TEE-BC-3001

# Stripe Configuration (set in GitHub Secrets / Railway Secrets for production)
# Product: "forbotsonly Tee" - $40 USD one-time
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_ACCOUNT_ID=acct_...
# STRIPE_PRODUCT_ID=prod_...
STRIPE_PRICE_ID=price_...

# Server Configuration
PORT=3001
PUBLIC_URL=http://localhost:3001

# Railway Public URL (set automatically by Railway in production)
# PUBLIC_URL=https://your-app.railway.app
